{
    "name": "mfrg/nebula-saasparilla",
    "description": "Saasparilla for Nebula: a Dieter Rams-inspired skin, child theme and dashboard instruments for the Qoliber Nebula admin on Magento Open Source.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": ["magento2", "nebula", "admin theme", "saasparilla", "tailwind"],
    "homepage": "https://github.com/mfrg/nebula-saasparilla",
    "authors": [
        { "name": "Christopher Dowson", "homepage": "https://myfirstraygun.studio" }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "magento/framework": "~103.0.9",
        "magento/module-backend": "*",
        "magento/module-sales": "*",
        "magento/module-customer": "*",
        "magento/module-payment": "*",
        "magento/module-config": "*",
        "nebula/admin": "^1.0"
    },
    "autoload": {
        "files": [
            "src/Skin/registration.php",
            "src/Dashboard/registration.php",
            "src/Theme/registration.php"
        ],
        "psr-4": {
            "MFRG\\SaasparillaSkin\\": "src/Skin/",
            "MFRG\\SaasparillaDashboard\\": "src/Dashboard/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
