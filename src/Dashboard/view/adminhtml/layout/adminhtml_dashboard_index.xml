<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="MFRG_SaasparillaDashboard::css/instruments.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template"
                   name="mfrg.dashboard.instruments"
                   template="MFRG_SaasparillaDashboard::instruments.phtml"
                   before="dashboard">
                <arguments>
                    <argument name="view_model" xsi:type="object">MFRG\SaasparillaDashboard\ViewModel\Instruments</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
